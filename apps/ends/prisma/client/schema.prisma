// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "./client"
}

generator prismaClassGenerator {
  provider = "prisma-class-generator"
  output   = "./prisma-class"
  dryRun   = false
}

datasource db {
  provider = "postgresql"
  url      = env("END_DATABASE_URL")
}

model User {
  id             String          @id @default(cuid())
  name           String?
  email          String          @unique
  emailVerified  DateTime?
  image          String?
  role           String?         @default("USER")
  accounts       Account[]
  sessions       Session[]
  // Optional for WebAuthn support
  Authenticator  Authenticator[]
  loginHistories LoginHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// Optional for WebAuthn support
model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
}

model LoginHistory {
  id          String   @id @default(uuid())
  userId      String
  platform    String // CMS / APP / MiniProgram 等
  device      String? // 设备简要信息（如 iPhone 14 / Chrome 118）
  fingerprint String?
  userAgent   String?
  ip          String   @db.VarChar(45) // IPv4 或 IPv6
  where       String?
  success     Boolean
  errorMsg    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, device])
  @@index([userId, fingerprint])
}

model Configuration {
  id          String   @id @default(uuid())
  namespace   String? // 可选：模块或逻辑分组名，例如 'system', 'feature', 'ui'
  key         String // 配置键名，例如 'homepage_banner', 'ip_whitelist'
  value       String // 原始存储值，字符串化后的 JSON/Text/Number 等
  valueType   String // 类型标识: 'json' | 'string' | 'number' | 'boolean' | 'text' | ...
  description String? // 说明字段（可用于 CMS 展示）
  isPublic    Boolean  @default(false) // 是否公开可读取（如供前端使用）
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([namespace, key])
  @@index([namespace])
}
